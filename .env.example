# Meta (Facebook) Ad Library API
META_ACCESS_TOKEN=your_meta_access_token_here

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# OpenAI API Key (for Whisper audio transcription)
OPENAI_API_KEY=your_openai_api_key_here

# Google AI Studio API Key (for Nano Banana Pro image gen & Veo 3.1 video gen)
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
